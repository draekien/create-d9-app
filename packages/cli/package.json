{
  "name": "@draekien/create-d9-app",
  "version": "0.0.10",
  "type": "module",
  "description": "Scaffold a Turborepo monorepo with TanStack Start, React, TypeScript, Biome, Tailwind, shadcn and pnpm, set up for AI coding agents",
  "keywords": [
    "create",
    "scaffold",
    "template",
    "monorepo",
    "turborepo",
    "pnpm",
    "tanstack",
    "tanstack-start",
    "react",
    "typescript",
    "biome",
    "tailwind",
    "shadcn",
    "agents"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/draekien/create-d9-app.git",
    "directory": "packages/cli"
  },
  "bin": {
    "create-d9-app": "index.js"
  },
  "files": [
    "index.js",
    "dist",
    "templates",
    "!templates/biome.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rolldown -c rolldown.config.ts",
    "typecheck": "tsc --noEmit",
    "refresh-templates": "node scripts/refresh-templates.ts",
    "test": "vitest run"
  },
  "devDependencies": {
    "@clack/prompts": "1.8.1",
    "@types/node": "22.20.5",
    "rolldown": "1.2.13",
    "skills": "1.7.1",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}

{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "root": false,
  "files": {
    "includes": [
      "**",
      "!**/routeTree.gen.ts",
      "!**/.biome",
      "!**/.intent",
      "!**/.claude",
      "!**/.agents",
      "!**/.codex"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf",
    "trailingNewline": true
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noReactPropAssignments": "error",
        "noUnresolvedImports": "off"
      },
      "performance": {
        "noJsxPropsBind": "off"
      },
      "style": {
        "noInferrableTypes": "error",
        "noNonNullAssertion": "error",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "react": {
                "allowImportNames": ["*"],
                "message": "Import React as a namespace: import * as React from \"react\". Biome's noUnresolvedImports cannot resolve named React imports such as Suspense."
              }
            }
          }
        },
        "useComponentExportOnlyModules": "error",
        "useConsistentTypeDefinitions": {
          "level": "error",
          "options": {
            "style": "type"
          }
        },
        "useFilenamingConvention": {
          "level": "error",
          "options": {
            "filenameCases": ["kebab-case"]
          }
        },
        "useReadonlyClassProperties": {
          "level": "error",
          "options": {
            "checkAllProperties": true
          }
        },
        "useThrowOnlyError": "error"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noVar": "error",
        "noUndeclaredEnvVars": "off"
      },
      "nursery": {
        "noBaseToString": "error",
        "noFloatingPromises": "error",
        "noIdenticalTestTitle": "error",
        "noImpliedEval": "error",
        "noLoopFunc": "error",
        "noMisusedPromises": "error",
        "noReturnInFinally": "error",
        "noUnmodifiedLoopCondition": "error",
        "noUnnecessaryTemplateExpression": "error",
        "noUnsafePlusOperands": "error",
        "noUnsafeTypeAssertion": "error",
        "noUselessTypeConversion": "error",
        "useArraySome": "error",
        "useAwaitThenable": "error",
        "useConsistentTestIt": "error",
        "useExhaustiveSwitchCases": {
          "level": "error",
          "options": {
            "requireExplicitCase": true
          }
        },
        "useExpect": "error",
        "useIncludes": "error",
        "useNullishCoalescing": "error",
        "useReactCompiler": "error",
        "useReduceTypeParameter": "error",
        "useRegexpExec": "error",
        "useRegexpTest": "error",
        "useStringStartsEndsWith": "error",
        "useTestHooksOnTop": "error"
      }
    },
    "domains": {
      "project": "all",
      "react": "all",
      "test": "all",
      "turborepo": "all",
      "types": "all"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "es5",
      "semicolons": "asNeeded"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on",
        "noDuplicateClasses": "on",
        "useSortedProperties": "on"
      }
    }
  },
  "plugins": [
    "./tools/biome/.biome/no-derived-state-effect.grit",
    "./tools/biome/.biome/no-double-assertion.grit",
    "./tools/biome/.biome/no-fetch-in-effect.grit",
    {
      "path": "./tools/biome/.biome/no-inline-query-key.grit",
      "includes": ["**/*.{ts,tsx}", "!**/*.test.{ts,tsx}"]
    },
    "./tools/biome/.biome/no-query-client-in-render.grit",
    "./tools/biome/.biome/effect-cleanup.grit",
    "./tools/biome/.biome/no-refetch-on-success.grit",
    {
      "path": "./tools/biome/.biome/query-client-stale-time.grit",
      "includes": ["**/*.{ts,tsx}", "!**/*.test.{ts,tsx}"]
    },
    {
      "path": "./tools/biome/.biome/no-try-around-jsx.grit",
      "includes": ["**/*.tsx"]
    },
    {
      "path": "./tools/biome/.biome/handler-naming.grit",
      "includes": ["**/*.tsx"]
    },
    {
      "path": "./tools/biome/.biome/no-default-props.grit",
      "includes": ["**/*.tsx"]
    },
    {
      "path": "./tools/biome/.biome/no-impure-render.grit",
      "includes": ["**/*.tsx"]
    },
    "./tools/biome/.biome/catch-binding-unknown.grit",
    "./tools/biome/.biome/use-assert-never.grit",
    {
      "path": "./tools/biome/.biome/no-direct-component-call.grit",
      "includes": ["**/*.tsx"]
    },
    {
      "path": "./tools/biome/.biome/no-state-mutation.grit",
      "includes": ["**/*.tsx"]
    },
    {
      "path": "./tools/biome/.biome/no-class-error-boundary.grit",
      "includes": ["**/*.tsx"]
    },
    {
      "path": "./tools/biome/.biome/no-fetch-in-handler.grit",
      "includes": ["**/*.tsx"]
    },
    "./tools/biome/.biome/route-option-order.grit",
    "./tools/biome/.biome/zod-validators.grit",
    {
      "path": "./tools/biome/.biome/use-cn-for-class-names.grit",
      "includes": ["**/*.tsx"]
    },
    {
      "path": "./tools/biome/.biome/use-cva-for-variants.grit",
      "includes": ["**/*.tsx"]
    },
    {
      "path": "./tools/biome/.biome/query-naming.grit",
      "includes": ["**/*.queries.ts"]
    },
    {
      "path": "./tools/biome/.biome/mutation-naming.grit",
      "includes": ["**/*.mutations.ts"]
    }
  ],
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": ["**/*.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "error"
          }
        }
      }
    },
    {
      "includes": ["**/src/routes/**/$*.tsx", "**/src/routes/**/*.$.tsx"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": "off"
          }
        }
      }
    },
    {
      "includes": ["**/src/routes/**"],
      "linter": {
        "rules": {
          "style": {
            "useComponentExportOnlyModules": "off"
          }
        }
      }
    }
  ]
}

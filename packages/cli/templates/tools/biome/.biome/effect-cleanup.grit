language js

or { `useEffect($callback, $...)`, `useLayoutEffect($callback, $...)` } as $effect where {
  $callback <: contains or { `$_.addEventListener($_, $_)`, `setInterval($_, $_)`, `setTimeout($_, $_)`, `$_.subscribe($_)` },
  or {
    $callback <: JsArrowFunctionExpression(body = JsFunctionBody(statements = $statements)),
    $callback <: JsFunctionExpression(body = JsFunctionBody(statements = $statements))
  },
  $statements <: not some `return $cleanup`,
  register_diagnostic(span = $effect, message = "Return a cleanup function from an effect that sets up a listener, timer, or subscription.")
}

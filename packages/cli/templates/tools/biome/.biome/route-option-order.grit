  JsObjectExpression(members = [$_, $_, $_, $_, $_, $_, $first, $_, $_, $_, $_, $second, ...]) where { $first <: out_of_order($second) },
  JsObjectExpression(members = [$_, $_, $_, $_, $_, $_, $_, $first, $second, ...]) where { $first <: out_of_order($second) },
  JsObjectExpression(members = [$_, $_, $_, $_, $_, $_, $_, $first, $_, $second, ...]) where { $first <: out_of_order($second) },
  JsObjectExpression(members = [$_, $_, $_, $_, $_, $_, $_, $first, $_, $_, $second, ...]) where { $first <: out_of_order($second) },
  JsObjectExpression(members = [$_, $_, $_, $_, $_, $_, $_, $first, $_, $_, $_, $second, ...]) where { $first <: out_of_order($second) },
  JsObjectExpression(members = [$_, $_, $_, $_, $_, $_, $_, $_, $first, $second, ...]) where { $first <: out_of_order($second) },
  JsObjectExpression(members = [$_, $_, $_, $_, $_, $_, $_, $_, $first, $_, $second, ...]) where { $first <: out_of_order($second) },
  JsObjectExpression(members = [$_, $_, $_, $_, $_, $_, $_, $_, $first, $_, $_, $second, ...]) where { $first <: out_of_order($second) },
  JsObjectExpression(members = [$_, $_, $_, $_, $_, $_, $_, $_, $_, $first, $second, ...]) where { $first <: out_of_order($second) },
  JsObjectExpression(members = [$_, $_, $_, $_, $_, $_, $_, $_, $_, $first, $_, $second, ...]) where { $first <: out_of_order($second) },
  JsObjectExpression(members = [$_, $_, $_, $_, $_, $_, $_, $_, $_, $_, $first, $second, ...]) where { $first <: out_of_order($second) }
} as $options where {
  $options <: within or {
    `createFileRoute($_)($options)`,
    `createRoute($options)`,
    `createRootRoute($options)`,
    JsCallExpression(callee = JsCallExpression(callee = r"createRootRouteWithContext[\s\S]*"), arguments = JsCallArguments(args = [$options]))
  },
  register_diagnostic(span = $first, message = "Order route options params/validateSearch, loaderDeps/search/ssr, context, beforeLoad, loader, then onEnter/onStay/onLeave/head/scripts/headers/remountDeps: each option infers its types from the options before it.", severity = "error")
}

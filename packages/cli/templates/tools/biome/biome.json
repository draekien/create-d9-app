{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!**/routeTree.gen.ts", "!.biome", "!.intent", "!.claude", "!.codex"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf",
    "trailingNewline": true
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noReactPropAssignments": "error"
      },
      "style": {
        "noInferrableTypes": "error",
        "useReadonlyClassProperties": "error",
        "useThrowOnlyError": "error",
        "useConsistentTypeDefinitions": {
          "level": "error",
          "options": {
            "style": "type"
          }
        },
        "useFilenamingConvention": {
          "level": "error",
          "options": {
            "filenameCases": ["kebab-case"]
          }
        }
      },
      "suspicious": {
        "noVar": "error"
      },
      "nursery": {
        "noBaseToString": "error",
        "noIdenticalTestTitle": "error",
        "noImpliedEval": "error",
        "noLoopFunc": "error",
        "noMisusedPromises": "error",
        "noReturnInFinally": "error",
        "noUnmodifiedLoopCondition": "error",
        "noUnnecessaryTemplateExpression": "error",
        "noUnsafePlusOperands": "error",
        "noUnsafeTypeAssertion": "error",
        "noUselessTypeConversion": "error",
        "useArraySome": "error",
        "useAwaitThenable": "error",
        "useConsistentTestIt": "error",
        "useExhaustiveSwitchCases": "error",
        "useExpect": "error",
        "useIncludes": "error",
        "useNullishCoalescing": "error",
        "useReactCompiler": "error",
        "useReduceTypeParameter": "error",
        "useRegexpExec": "error",
        "useRegexpTest": "error",
        "useStringStartsEndsWith": "error",
        "useTestHooksOnTop": "error"
      }
    },
    "domains": {
      "project": "all",
      "react": "all",
      "test": "all",
      "turborepo": "all",
      "types": "all"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "es5",
      "semicolons": "asNeeded"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on",
        "noDuplicateClasses": "on",
        "useSortedProperties": "on"
      }
    }
  },
  "plugins": [
    ".biome/no-derived-state-effect.grit",
    ".biome/no-double-assertion.grit",
    ".biome/no-fetch-in-effect.grit",
    {
      "path": ".biome/no-inline-query-key.grit",
      "includes": ["**/*.{ts,tsx}", "!**/*.test.{ts,tsx}"]
    },
    ".biome/no-query-client-in-render.grit",
    ".biome/effect-cleanup.grit",
    ".biome/no-refetch-on-success.grit",
    {
      "path": ".biome/query-client-stale-time.grit",
      "includes": ["**/*.{ts,tsx}", "!**/*.test.{ts,tsx}"]
    },
    {
      "path": ".biome/no-try-around-jsx.grit",
      "includes": ["**/*.tsx"]
    },
    {
      "path": ".biome/handler-naming.grit",
      "includes": ["**/*.tsx"]
    },
    {
      "path": ".biome/no-default-props.grit",
      "includes": ["**/*.tsx"]
    },
    {
      "path": ".biome/no-impure-render.grit",
      "includes": ["**/*.tsx"]
    }
  ],
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": ["**/*.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "error"
          }
        }
      }
    },
    {
      "includes": ["**/src/routes/**/$*.tsx", "**/src/routes/**/*.$.tsx"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": "off"
          }
        }
      }
    }
  ]
}
